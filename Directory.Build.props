<Project>
  <Import Project="$(MSBuildThisFileDirectory)Environment.props" Condition="Exists('$(MSBuildThisFileDirectory)Environment.props')" />

  <!-- Keeps bin/obj outside the source tree when it is synced between machines, so they never overwrite each other. -->
  <PropertyGroup Condition="'$(HAUGBUI_BUILD_ROOT)' != ''">
    <BaseIntermediateOutputPath>$(HAUGBUI_BUILD_ROOT)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(HAUGBUI_BUILD_ROOT)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <!-- The other machine's in-tree bin/obj arrive through the sync and must not be compiled. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <HaugbuiVersion>0.0.6</HaugbuiVersion>
    <Version>$(HaugbuiVersion)</Version>

    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <!-- On machines without the game (macOS planning machine), the Managed folder copied to .reference/ is used, or to
         ../haugbui-reference/ when it is kept outside a synced source folder. -->
    <VALHEIM_MANAGED Condition="'$(VALHEIM_MANAGED)' == '' And Exists('$(VALHEIM_INSTALL)\valheim_Data\Managed')">$(VALHEIM_INSTALL)\valheim_Data\Managed</VALHEIM_MANAGED>
    <VALHEIM_MANAGED Condition="'$(VALHEIM_MANAGED)' == '' And Exists('$(MSBuildThisFileDirectory).reference/Managed')">$(MSBuildThisFileDirectory).reference/Managed</VALHEIM_MANAGED>
    <VALHEIM_MANAGED Condition="'$(VALHEIM_MANAGED)' == ''">$(MSBuildThisFileDirectory)../haugbui-reference/Managed</VALHEIM_MANAGED>
  </PropertyGroup>
</Project>
